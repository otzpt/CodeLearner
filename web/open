#!/bin/sh
# Opens one web course in the default browser. Registered in
# launcher/src/main.c the way java/run is: the launcher can only start a
# program, and these courses are pages.
#
#   ./open html|css|js

page="$(cd "$(dirname "$0")" && pwd)/$1/index.html"
if [ ! -f "$page" ]; then
    echo "No such course: $1" >&2
    exit 1
fi

echo
echo "  This course runs in your browser. Opening:"
echo "  $page"
echo

if command -v xdg-open >/dev/null 2>&1 && xdg-open "$page" >/dev/null 2>&1; then
    echo "  If no window appeared, open that file yourself."
else
    echo "  Could not start a browser from here. Open that file yourself."
fi

printf '\n  Press ENTER to go back...'
read -r _ || true
